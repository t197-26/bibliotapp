<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/LoginArrowBack"
            style="@style/ArrowBack"
            app:srcCompat="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Espaços"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:textColor="#000000" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:layout_marginTop="24dp"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- Example of slot styles -->
        <Button
            android:text="C1"
            style="@style/SlotDisponivel" />

        <Button
            android:text="C3"
            style="@style/SlotIndisponivel" />

        <Button
            android:text="C5"
            style="@style/SlotDisponivel" />

        <Button
            style="@style/SlotEscolhido"
            android:layout_row="0"
            android:layout_column="3"
            android:text="C7" />

        <Button
            android:text="C9"
            style="@style/SlotDisponivel" />

        <Button
            android:text="C2"
            style="@style/SlotDisponivel" />

        <Button
            android:text="C4"
            style="@style/SlotIndisponivel" />

        <Button
            android:text="C6"
            style="@style/SlotDisponivel" />

        <Button
            android:text="C8"
            style="@style/SlotIndisponivel" />

        <Button
            android:text="C10"
            style="@style/SlotDisponivel" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#4285F4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Disponível"
            android:layout_marginEnd="16dp"
            android:textSize="14sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#34A853" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Escolhido"
            android:layout_marginEnd="16dp"
            android:textSize="14sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#C4C4C4" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Indisponível"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnReservar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reservar"
        android:textAllCaps="false"
        android:backgroundTint="#4285F4"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="8dp"
        android:paddingVertical="12dp" />

</LinearLayout>
