<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Book Cover Thumbnail -->
        <ImageView
            android:id="@+id/ivRequestBookCover"
            android:layout_width="60dp"
            android:layout_height="85dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/book_01" />

        <!-- Request Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Book Title -->
            <TextView
                android:id="@+id/tvRequestBookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Sistemas de informação e as decisões ..."
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Request Date -->
            <TextView
                android:id="@+id/tvRequestDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pedido em: 20/09/2025"
                android:textColor="#666666"
                android:textSize="12sp" />

            <!-- Pages -->
            <TextView
                android:id="@+id/tvRequestPages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Páginas: 10, 11, 25-30, 32, 45-50"
                android:textColor="#666666"
                android:textSize="12sp" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvRequestStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_badge"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Em fila"
                android:textColor="#FF6B00"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btnCloseRequest"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar"
            android:src="@drawable/ic_arrow_back" />

    </LinearLayout>

</androidx.cardview.widget.CardView>